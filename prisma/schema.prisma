generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceKind {
  COURT
  ROOM
  DESK
  EQUIPMENT
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Organization {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  locations          Location[]
  resources          Resource[]
  providers          Provider[]
  bookings           Booking[]
  idempotencyRecords IdempotencyRecord[]
  waitlistEntries    WaitlistEntry[]
  membershipPlans    MembershipPlan[]
  memberships        Membership[]
  servicePackages    ServicePackage[]
  packageBalances    PackageBalance[]
  pricingRules       PricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  timeZone       String
  address        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      Resource[]
  providers      Provider[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, timeZone])
}

model AvailabilityRule {
  id               String    @id @default(cuid())
  organizationId   String
  resourceId       String
  weekday          Int
  startMinute      Int
  endMinute        Int
  slotMinutes      Int
  effectiveFrom    DateTime  @db.Date
  effectiveUntil   DateTime? @db.Date
  utcOffsetMinutes Int?
  resource         Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, resourceId, weekday, effectiveFrom])
}

model Resource {
  id                String             @id @default(cuid())
  organizationId    String
  locationId        String
  name              String
  kind              ResourceKind
  capacity          Int                @default(1)
  active            Boolean            @default(true)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  pricingRules      PricingRule[]

  @@unique([locationId, name])
  @@index([organizationId, active])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  organizationId String
  resourceId     String
  startsAt       DateTime
  customerName   String
  customerEmail  String
  status         WaitlistStatus @default(WAITING)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([resourceId, startsAt, customerEmail])
  @@index([organizationId, status, startsAt])
}

model MembershipPlan {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  discountBps       Int          @default(0)
  monthlyPriceMinor Int
  includedCredits   Int          @default(0)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships       Membership[]
  createdAt         DateTime     @default(now())

  @@unique([organizationId, name])
}

model Membership {
  id               String           @id @default(cuid())
  organizationId   String
  planId           String
  customerEmail    String
  remainingCredits Int              @default(0)
  status           MembershipStatus @default(ACTIVE)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())

  @@unique([organizationId, customerEmail])
}

model ServicePackage {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  credits        Int
  priceMinor     Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances       PackageBalance[]
  createdAt      DateTime         @default(now())

  @@unique([organizationId, name])
}

model PackageBalance {
  id               String         @id @default(cuid())
  organizationId   String
  packageId        String
  customerEmail    String
  remainingCredits Int
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package          ServicePackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@unique([packageId, customerEmail])
}

model PricingRule {
  id             String       @id @default(cuid())
  organizationId String
  resourceId     String?
  name           String
  adjustmentBps  Int
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int          @default(100)
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       Resource?    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, resourceId, active, priority])
}

model Booking {
  id              String        @id @default(cuid())
  organizationId  String
  resourceId      String
  customerName    String
  customerEmail   String
  accessTokenHash String        @unique
  startsAt        DateTime
  endsAt          DateTime
  status          BookingStatus @default(CONFIRMED)
  priceMinor      Int           @default(0)
  currency        String        @default("USD")
  cancelledAt     DateTime?
  refundMinor     Int?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource        Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([resourceId, startsAt])
  @@index([organizationId, customerEmail, startsAt])
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  organizationId String
  keyHash        String
  requestHash    String
  bookingId      String
  response       Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, keyHash])
}

model Provider {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String?
  displayName    String
  email          String
  status         ProviderStatus @default(ACTIVE)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
}
