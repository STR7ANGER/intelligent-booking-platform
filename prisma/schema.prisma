generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceKind {
  COURT
  ROOM
  DESK
  EQUIPMENT
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Organization {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  locations          Location[]
  resources          Resource[]
  providers          Provider[]
  bookings           Booking[]
  idempotencyRecords IdempotencyRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  timeZone       String
  address        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      Resource[]
  providers      Provider[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, timeZone])
}

model AvailabilityRule {
  id               String    @id @default(cuid())
  organizationId   String
  resourceId       String
  weekday          Int
  startMinute      Int
  endMinute        Int
  slotMinutes      Int
  effectiveFrom    DateTime  @db.Date
  effectiveUntil   DateTime? @db.Date
  utcOffsetMinutes Int?
  resource         Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, resourceId, weekday, effectiveFrom])
}

model Resource {
  id                String             @id @default(cuid())
  organizationId    String
  locationId        String
  name              String
  kind              ResourceKind
  capacity          Int                @default(1)
  active            Boolean            @default(true)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  availabilityRules AvailabilityRule[]
  bookings          Booking[]

  @@unique([locationId, name])
  @@index([organizationId, active])
}

model Booking {
  id              String        @id @default(cuid())
  organizationId  String
  resourceId      String
  customerName    String
  customerEmail   String
  accessTokenHash String        @unique
  startsAt        DateTime
  endsAt          DateTime
  status          BookingStatus @default(CONFIRMED)
  priceMinor      Int           @default(0)
  currency        String        @default("USD")
  cancelledAt     DateTime?
  refundMinor     Int?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource        Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([resourceId, startsAt])
  @@index([organizationId, customerEmail, startsAt])
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  organizationId String
  keyHash        String
  requestHash    String
  bookingId      String
  response       Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, keyHash])
}

model Provider {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String?
  displayName    String
  email          String
  status         ProviderStatus @default(ACTIVE)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
}
